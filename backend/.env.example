# ========================================================
# CYCLONESHIELD AI - ENVIRONMENT CONFIGURATION
# ========================================================

# --------------------------------------------------------
# 1. Google Gemini AI API (Required for Real AI Analysis)
# Get a free API key at: https://aistudio.google.com/
# --------------------------------------------------------
GEMINI_API_KEY=

# --------------------------------------------------------
# 2. Meteorological / Weather Data
# Default: open-meteo (REAL live ECMWF/GFS weather, NO API KEY NEEDED!)
# Options: open-meteo | openweathermap | weatherapi
# --------------------------------------------------------
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# --------------------------------------------------------
# 3. Google Earth Engine (GEE) Satellite Services
# Sign up at: https://earthengine.google.com/
# Create service account at Google Cloud Console and set path
# --------------------------------------------------------
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --------------------------------------------------------
# 4. Cyclone Track Provider
# Options: live (NOAA NHC & JTWC active feeds) | ibtracs (historical archive)
# --------------------------------------------------------
CYCLONE_PROVIDER=live

# --------------------------------------------------------
# 5. Database Configuration
# PostgreSQL is recommended for production. SQLite used for zero-setup local execution.
# --------------------------------------------------------
DATABASE_URL=sqlite:///./cycloneshield.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cycloneshield

# --------------------------------------------------------
# 6. Early Warning & Alert Notification Providers
# When credentials are empty, alerts operate in SIMULATION ONLY mode.
# --------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=

# --------------------------------------------------------
# 7. Deterministic Risk Engine Configuration
# Sum of weights must equal 1.00
# --------------------------------------------------------
RISK_WEIGHT_SURGE=0.25
RISK_WEIGHT_WIND=0.20
RISK_WEIGHT_RAIN=0.20
RISK_WEIGHT_INFRA=0.20
RISK_WEIGHT_EXPOSURE=0.15

# Server Port and Host
HOST=0.0.0.0
PORT=8000
